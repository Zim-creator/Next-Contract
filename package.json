{
	"name": "@zim-creator/next-contract",
	"version": "0.0.1",
	"description": "Type-safe contracts for seamless communication between client components, server components, API routes, and backend services in Next.js.",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#src/*": {
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./shared": {
			"types": "./dist/shared.d.ts",
			"import": "./dist/shared.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check:fix:unsafe": "biome check --write --unsafe .",
		"ci": "biome ci .",
		"prepack": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:types": "tsc -p tsconfig.test.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "26.6.3",
		"@vitest/coverage-v8": "5.0.2",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "yarn@4.18.1"
}
